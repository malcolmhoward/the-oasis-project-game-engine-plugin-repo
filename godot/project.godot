; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited using a text editor.

[application]

config/name="O.A.S.I.S. Godot Plugin"
config/description="OCP plugin and demos for the O.A.S.I.S. ecosystem"
config/version="0.1.0"
run/main_scene="res://demos/oasis_monitor/scenes/main.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"

[autoload]

OasisMQTT="*res://addons/oasis_ocp/oasis_mqtt_autoload.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/oasis_ocp/plugin.cfg")

[input]

toggle_presentation_mode={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"location":0,"echo":false,"script":null)
]
}

[debug]

gdscript/warnings/inferred_declaration=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[rendering]

renderer/rendering_method="gl_compatibility"
